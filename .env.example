# Copy to .env.local (gitignored) and fill in real values.
# Required for the voicemail notify feature (lib/ntfy.ts) — omit these and
# it just logs a warning and skips sending, nothing else breaks.

# Base URL of your ntfy server.
NTFY_URL=https://ntfy.example.com

# ntfy topic to publish voicemail notifications to. Treat this like a
# secret if your ntfy server doesn't enforce per-topic auth — anyone who
# knows it can publish to (and possibly read) it.
NTFY_TOPIC=your-topic-name

# This pi-web instance's own public HTTPS URL (e.g. a Tailscale MagicDNS
# hostname) — used to build the link the notification's iOS Shortcut
# fetches audio from. Also used by next.config.ts's allowedDevOrigins in
# dev mode.
PI_WEB_PUBLIC_URL=https://your-hostname.example.ts.net

# Xiaomi MiMo API key (tp- token-plan or sk- pay-as-you-go) — required for
# voice input ONLY: app/api/transcribe/route.ts sends recordings to MiMo ASR
# (mimo-v2.5-asr, language=en) and has no local-STT fallback. Missing key →
# voice input returns 503. Each deployment (desktop, server container) holds
# its own copy. See Guides .../pi-audio/stt.md.
# (TTS no longer uses MiMo — the /chat read-aloud fallback is piper, below.)
MIMO_API_KEY=

# Read-aloud fallback for the /chat voice page (lib/chat-tts.ts). The desktop's
# TTS router (:8880) is always tried first; this is what gets used when the
# desktop is unreachable. Default is the server's tailnet IP, where piper-tts
# (/opt/piper-tts) publishes besides its loopback bind — that address reaches it
# from both deployments (server container and desktop service). Piper has no
# auth: keep it tailnet-only.
# PI_CHAT_TTS_FALLBACK_URL=http://100.93.215.27:8900

# Host running the local llama-server / TTS / STT services. Leave unset when
# pi-web runs on that same machine (defaults to 127.0.0.1). Set it to the
# desktop's reachable address when pi-web runs elsewhere — e.g. the
# containerized instance on the server.
# DESKTOP_HOST=192.168.1.50

# Port the *desktop's* pi-web listens on. Only used when DESKTOP_HOST points
# somewhere else: start/stop in the Local Server panel can't exec the
# launcher scripts from a container, so those requests are forwarded to the
# desktop's own pi-web, which runs `addie` locally. Status probes go straight
# to the model ports and don't use this. Default: 30141.
# DESKTOP_PI_WEB_PORT=30141
